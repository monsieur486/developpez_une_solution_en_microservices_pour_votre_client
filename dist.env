# Modèle de secrets de développement : copier en .env (cp dist.env .env), jamais commiter .env.

# Configuration base de données PostgreSQL
POSTGRES_DB=patientsdb
POSTGRES_USER=patient_user
POSTGRES_PASSWORD=patient_pass

# Configuration base de données MongoDB
# ms-notes n'a plus de mot de passe par défaut : sans ces lignes, il refuse de démarrer.
MONGO_INITDB_ROOT_USERNAME=notes_user
MONGO_INITDB_ROOT_PASSWORD=notes_password

# Utilisateur technique des API REST (HTTP Basic), partagé par les microservices et ms-webclient.
# Les microservices n'ont plus de mot de passe par défaut : sans ces lignes, ils refusent de démarrer.
APP_USERNAME=app_user
APP_PASSWORD=app_password

# Contextes Liquibase de ms-patients : « demo » insère les quatre patients de test.
# Retirer cette ligne en production (le défaut « prod » n'insère aucune donnée de test).
LIQUIBASE_CONTEXTS=demo

# Profils de ms-notes : « demo » insère les neuf notes de test (migration Mongock).
# Retirer cette ligne en production (le défaut « prod » n'insère aucune donnée de test).
MONGOCK_PROFILES=demo
