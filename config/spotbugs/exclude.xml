<?xml version="1.0" encoding="UTF-8"?>

<FindBugsFilter>

    <Match>
        <Package name="~.*\.dto"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Or>
            <Package name="~.*\.dbchangelogs"/>
            <Package name="~.*\.service"/>
            <Package name="~.*\.configuration"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

</FindBugsFilter>
